# ==============================================================================
# AigisBot Backend Configuration (.env.example)
# Copy this file to `.env` and fill in your values. NEVER commit `.env`.
# ==============================================================================

NODE_ENV=development
LOG_LEVEL=info

# --- WhatsApp Gateway ---
WA_AUTH_DIR=auth_info

# Optional: Isi nomor bot (format internasional tanpa +, misal 6281234567890)
# untuk login memakai 8-digit Pairing Code. Kosongkan jika ingin memakai QR Code.
WA_PAIRING_PHONE=

# Daftar Group JID yang diizinkan (pisahkan dengan koma, misal: 120363xxxxx@g.us).
# Kosongkan dulu saat setup awal untuk melihat Group JID di terminal log.
ALLOWED_GROUP_JIDS=

# Nomor WA Owner/Admin (format internasional tanpa +, pisahkan dengan koma)
BOT_OWNER_NUMBERS=

# --- LLM Brain ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=10000

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Set false di Free Tier (mengandalkan RSS berita ATLUS gratis agar tidak kena 429 Search Grounding)
ENABLE_SEARCH_GROUNDING=false
NEWS_FEED_CACHE_TTL_MS=900000

# --- SQLite Memory ---
DB_PATH=data/aigis.db
GROUP_CONTEXT_WINDOW_SIZE=12
GROUP_MESSAGE_RETENTION_LIMIT=100

# Optional local JSON seed (simpan di folder data/ agar tetap ter-gitignore!)
COMMUNITY_SEED_PATH=data/community_seed.local.json

# --- Flood, Tiered Cooldown & Sanitizer Guard ---
# Free Tier (Member biasa)
USER_COOLDOWN_MS=15000
GROUP_COOLDOWN_MS=5000

# Pro Tier (Group Admin via WA metadata / Bot Owner)
ADMIN_COOLDOWN_MS=4000
ADMIN_GROUP_COOLDOWN_MS=2000

# Reaksi emoji saat rate-limited (isi "none" atau kosongkan untuk pure silent drop)
COOLDOWN_REACT_EMOJI=⏳
GROUP_METADATA_CACHE_TTL_MS=300000
MAX_PROMPT_CHARS=1500
MAX_QUOTED_CHARS=1000
