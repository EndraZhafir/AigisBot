{
  "name": "aigis-bot-backend",
  "version": "0.1.0",
  "description": "AigisBot — ATLUS Community WhatsApp Bot (Aigis from Persona 3)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "sandbox": "tsx src/cli-sandbox.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "@hapi/boom": "^9.1.3",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "dotenv": "^18.0.10",
    "pino": "^9.6.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
